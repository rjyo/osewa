<script is:inline>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const D = 1600;                       // distance between levels
const P = 900;                        // focal length, like CSS perspective
const NEAR = P - 30, FAR = 9000;
const FLOOR = 430, WALL = 1400, CEIL = -970, GRID = 160;
const levels = [...document.querySelectorAll('.level')];
const N = levels.length;
const pad = n => String(n).padStart(2, '0');
levels.forEach((l, i) => { l.style.zIndex = N - i; l.fit = 1; });

const motes = [];
for (let k = 0; k < 160; k++) {
  const x = (Math.random() * 2 - 1) * 1300, y = (Math.random() * 2 - 1) * 650, z = 600 - Math.random() * (N * D);
  if (Math.abs(x) < 620 && Math.abs(y) < 440) continue;  // keep motes out of the card
  motes.push({ x, y, z, red: Math.random() < .18 });
}

const cv = document.getElementById('stage'), g = cv.getContext('2d');
let W = 0, H = 0;
function size() {
  const dpr = Math.min(2, devicePixelRatio || 1);
  W = innerWidth; H = innerHeight;
  cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
}

// Per-level environment colour.
const envs = levels.map(l => l.dataset.env || (l.classList.contains('dark') ? '#111111' : '#F4F4F1'));
const rgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
const mix = (a, b, t) => a.map((v, i) => Math.round(v + (b[i] - v) * t));

// HUD: index, segments.
const idx = document.getElementById('idx'), segs = document.getElementById('segs'), spacer = document.getElementById('spacer');
segs.style.gridTemplateColumns = `repeat(${N}, 1fr)`;
const hl = document.createElement('span');
hl.className = 'hl';
idx.appendChild(hl);
const segfill = document.getElementById('segfill');
const CHECK = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.8 6.4 4.6 9.2 10.4 2.8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>';
const PLAY = '<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1 9 5 2 9Z" fill="currentColor"/></svg>';
document.getElementById('lvt').textContent = pad(N - 1);
const visited = new Set([0]);
levels.forEach((l, i) => {
  spacer.appendChild(document.createElement('div'));
  const b = document.createElement('button');
  b.innerHTML = `<span class="ck"></span><span>${pad(i)}</span><span>${l.dataset.name}</span>`;
  b.onclick = () => go(i);
  idx.insertBefore(b, hl);
  const s = document.createElement('button');
  s.setAttribute('aria-label', 'Level ' + i);
  s.onclick = () => go(i);
  segs.append(s);
});
const go = i => scrollTo({ top: Math.max(0, Math.min(N - 1, i)) * innerHeight, behavior: reduce ? 'auto' : 'smooth' });
for (const a of document.querySelectorAll('[data-go]')) a.addEventListener('click', e => { e.preventDefault(); go(+a.dataset.go); });

addEventListener('keydown', e => {
  if (['ArrowDown', 's', 'S', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); go(cur + 1); }
  else if (['ArrowUp', 'w', 'W', 'PageUp'].includes(e.key)) { e.preventDefault(); go(cur - 1); }
  else if (/^[1-9]$/.test(e.key)) go(+e.key - 1);
});

let mx = 0, my = 0;
addEventListener('pointermove', e => { mx = e.clientX / innerWidth - .5; my = e.clientY / innerHeight - .5; });

const banner = document.getElementById('banner');
let bannerT;
function announce(i, prev) {
  const clear = i > prev ? `<span class="c">LV ${pad(prev)} CLEAR</span><span>·</span>` : '';
  banner.innerHTML = `${clear}${PLAY}<span>LEVEL ${pad(i)} · ${levels[i].dataset.name.toUpperCase()}</span>`;
  banner.classList.add('show');
  const neko = document.getElementById('neko');
  neko.classList.remove('wave'); void neko.getBBox(); neko.classList.add('wave');
  clearTimeout(bannerT);
  bannerT = setTimeout(() => banner.classList.remove('show'), 1600);
}

let cam = 0, cur = -1, px = 0, py = 0, lastKey = '';
const hudTop = document.querySelector('.hud.tl'), bot = document.querySelector('.bot');
function fit() {
  size();
  // Cards zoom about the screen centre, so the room is twice the nearer gap
  // to the header or the bottom bar.
  const edge = Math.max(hudTop.getBoundingClientRect().bottom, innerHeight - bot.getBoundingClientRect().top) + 10;
  const aw = innerWidth - 32, ah = innerHeight - 2 * edge;
  const phone = innerWidth <= 860;
  levels.forEach(l => {
    l.style.width = phone ? aw + 'px' : '';
    // A tall card on a phone would shrink into a strip; widen it until its
    // shape matches the free space, then scale it to fill that space.
    if (phone && l.offsetHeight > ah) {
      let lo = aw, hi = aw * 3;
      for (let n = 0; n < 9; n++) {
        const w = (lo + hi) / 2;
        l.style.width = w + 'px';
        if (w / l.offsetHeight < aw / ah) lo = w; else hi = w;
      }
      l.style.width = hi + 'px';
    }
    l.fit = Math.min(1, ah / l.offsetHeight, aw / l.offsetWidth);
  });
  lastKey = '';
}
fit();
document.fonts.ready.then(fit);
addEventListener('resize', fit);

// Camera space: world z plus cam. Visible while zc < NEAR.
function draw(env, fg, ox, oy) {
  const cx = W / 2, cy = H / 2;
  const proj = (x, y, zc) => { const k = P / (P - zc); return [ox + (x + cx - ox) * k, oy + (y + cy - oy) * k, k]; };
  const fog = zc => Math.max(0, Math.min(1, 1 + zc / (FAR * .8)));
  const ink = a => `rgba(${fg},${a.toFixed(3)})`;
  g.fillStyle = `rgb(${env})`;
  g.fillRect(0, 0, W, H);
  g.lineWidth = 1;
  const seg = (x1, y1, z1, x2, y2, z2, a) => {
    if (a < .004) return;
    // Clip against the near plane so lines through the camera don't explode.
    if (z1 > NEAR && z2 > NEAR) return;
    if (z1 > NEAR) { const t = (NEAR - z1) / (z2 - z1); x1 += (x2 - x1) * t; y1 += (y2 - y1) * t; z1 = NEAR; }
    if (z2 > NEAR) { const t = (NEAR - z2) / (z1 - z2); x2 += (x1 - x2) * t; y2 += (y1 - y2) * t; z2 = NEAR; }
    const [a1, b1] = proj(x1, y1, z1), [a2, b2] = proj(x2, y2, z2);
    g.strokeStyle = ink(a);
    g.beginPath(); g.moveTo(a1, b1); g.lineTo(a2, b2); g.stroke();
  };
  const STEP = 600;
  // Lines running down the corridor, split so each piece can fade with distance.
  for (let zc = NEAR; zc > -FAR; zc -= STEP) {
    const z2 = Math.max(-FAR, zc - STEP), a = .13 * fog((zc + z2) / 2);
    for (let x = -WALL; x <= WALL; x += GRID) seg(x, FLOOR, zc, x, FLOOR, z2, a);
    for (let y = FLOOR; y >= CEIL; y -= GRID) {
      const h = Math.max(0, Math.min(1, (y - CEIL) / (FLOOR - CEIL) * 1.6));
      seg(-WALL, y, zc, -WALL, y, z2, a * h); seg(WALL, y, zc, WALL, y, z2, a * h);
    }
  }
  // Rungs across the floor and up the walls, fixed to world z so they stream past.
  const first = Math.floor((NEAR - cam) / GRID) * GRID;
  for (let z = first; z + cam > -FAR; z -= GRID) {
    const zc = z + cam, a = .13 * fog(zc);
    seg(-WALL, FLOOR, zc, WALL, FLOOR, zc, a);
    for (const x of [-WALL, WALL]) { seg(x, FLOOR, zc, x, -100, zc, a); seg(x, -100, zc, x, CEIL, zc, a * .35); }
  }
  // Motes.
  for (const m of motes) {
    const zc = m.z + cam;
    if (zc > NEAR || zc < -FAR) continue;
    const [sx, sy, k] = proj(m.x, m.y, zc), r = 6 * k;
    g.fillStyle = m.red ? `rgba(224,57,62,${(.8 * fog(zc)).toFixed(3)})` : ink(.35 * fog(zc));
    g.fillRect(sx - r / 2, sy - r / 2, r, r);
  }
  // Gates, far to near so nearer ones paint over.
  for (let i = N - 1; i >= 0; i--) {
    const zc = -i * D + 260 + cam;
    if (zc > NEAR - 40 || zc < -FAR) continue;
    // Gone by the time you reach its card (zc = 260), or its edge sits on the HUD.
    const o = zc < 0 ? Math.max(0, 1 + zc / 3200) : Math.max(0, 1 - zc / 200);
    if (o < .01) continue;
    const [x0, y0, k] = proj(-620, -410, zc), [x1, y1] = proj(620, 410, zc);
    g.globalAlpha = o;
    g.strokeStyle = `rgb(${fg})`; g.lineWidth = 3 * k;
    g.strokeRect(x0, y0, x1 - x0, y1 - y0);
    g.strokeStyle = '#E0393E'; g.lineWidth = 6 * k;
    const L = 60 * k, e = 12 * k;
    g.beginPath();
    g.moveTo(x0 - e, y0 - e + L); g.lineTo(x0 - e, y0 - e); g.lineTo(x0 - e + L, y0 - e);
    g.moveTo(x1 + e, y1 + e - L); g.lineTo(x1 + e, y1 + e); g.lineTo(x1 + e - L, y1 + e);
    g.stroke();
    const label = `LEVEL ${pad(i)} · ${levels[i].dataset.name.toUpperCase()}`;
    g.font = `600 ${13 * k}px "JetBrains Mono", monospace`;
    const tw = g.measureText(label).width;
    g.fillStyle = `rgb(${env})`; g.fillRect(x0 + 14 * k, y0 - 11 * k, tw + 20 * k, 22 * k);
    g.fillStyle = `rgb(${fg})`; g.textBaseline = 'middle'; g.fillText(label, x0 + 24 * k, y0 + 1 * k);
    // Big outlined level number standing beside the gate.
    g.font = `700 ${380 * k}px "JetBrains Mono", monospace`;
    g.lineWidth = 2 * k; g.strokeStyle = ink(.16);
    g.textBaseline = 'alphabetic';
    const [nx, ny] = proj(660, 410, zc);
    g.strokeText(pad(i), nx, ny);
    g.globalAlpha = 1;
  }
  g.lineWidth = 1;
}

let shown = -1;
function paintIndex() {
  idx.querySelectorAll('button').forEach((b, i) => {
    b.classList.toggle('cur', i === shown);
    b.classList.toggle('v', visited.has(i));
    b.firstChild.innerHTML = i === shown ? PLAY : visited.has(i) ? CHECK : '';
  });
}
function frame() {
  const p = shot ?? scrollY / innerHeight;
  const target = p * D;
  cam += (target - cam) * (reduce ? 1 : .085);
  if (Math.abs(target - cam) < .5) cam = target;
  px += (mx - px) * .05; py += (my - py) * .05;
  if (Math.abs(mx - px) < .002) px = mx;
  if (Math.abs(my - py) < .002) py = my;
  // Nothing moves once the camera settles, so stop painting.
  const key = cam + '|' + px + '|' + py;
  if (key === lastKey) { requestAnimationFrame(frame); return; }
  lastKey = key;
  // The corridor's vanishing point follows the mouse a little; the cards zoom
  // about the screen centre so they never slide sideways or vertically.
  const ox = W * (.5 + px * .06), oy = H * (.5 + py * .05);

  const fp = cam / D;
  const a = Math.max(0, Math.min(N - 1, Math.floor(fp))), b = Math.min(N - 1, a + 1), t = Math.min(1, Math.max(0, fp - a));
  const env = mix(rgb(envs[a]), rgb(envs[b]), t);
  const lum = (env[0] * .3 + env[1] * .59 + env[2] * .11) / 255;
  const fg = lum > .5 ? [17, 17, 17] : [244, 244, 241];
  const root = document.documentElement.style;
  root.setProperty('--env', `rgb(${env})`);
  root.setProperty('--fg', `rgb(${fg})`);
  draw(env, fg, ox, oy);

  levels.forEach((l, i) => {
    const zc = cam - i * D;              // >0 means we've passed it
    const o = zc >= NEAR - 40 ? 0 : zc < 0 ? Math.max(0, 1 + zc / 2400) : Math.max(0, 1 - zc / 380);
    const os = o.toFixed(2);
    if (l._o !== os) { l._o = os; l.style.opacity = os; l.style.visibility = o < .01 ? 'hidden' : 'visible'; }
    if (o < .01) return;
    const k = P / (P - zc);
    l.style.transform = `translate(-50%, -50%) scale(${(k * l.fit).toFixed(4)})`;
  });

  // The index and the red bar point at where you're going, right away; only the
  // cat travels with the camera.
  const dest = Math.max(0, Math.min(N - 1, Math.round(p)));
  if (dest !== shown) { shown = dest; paintIndex(); }
  // Measure the target row and segment each time; a fixed step rounds and drifts.
  const row = idx.querySelectorAll('button')[dest].getBoundingClientRect(), box = idx.getBoundingClientRect();
  hl.style.height = row.height + 'px';
  hl.style.transform = `translateY(${row.top - box.top}px)`;
  const sg = segs.querySelectorAll('button')[dest].getBoundingClientRect(), sb = segs.getBoundingClientRect();
  segfill.style.width = sg.width + 'px';
  segfill.style.transform = `translateX(${sg.left - sb.left}px)`;

  const near = Math.round(fp);
  if (near !== cur && Math.abs(fp - near) < .12) {
    const prev = cur;
    cur = near;
    visited.add(cur);
    levels.forEach((l, i) => {
      l.classList.toggle('on', i === cur);
      l.querySelectorAll('.bar').forEach(bar => bar.style.width = i === cur ? `calc(${bar.dataset.w} * .78)` : '0');
    });
    paintIndex();
    [...segs.querySelectorAll('button')].forEach((s, i) => s.classList.toggle('v', visited.has(i)));
    document.getElementById('lvn').textContent = pad(cur);
    document.getElementById('lvname').textContent = levels[cur].dataset.name;
    document.getElementById('cleared').textContent = `${visited.size} / ${N} visited`;
    if (prev >= 0) announce(cur, prev);
  }
  requestAnimationFrame(frame);
}
// ?shot=N parks the camera at level N without scrolling, for screenshots.
const shotM = /shot=([\d.]+)/.exec(location.search), shot = shotM ? +shotM[1] : null;
if (shot !== null) cam = shot * D;
const deep = levels.findIndex(l => '#' + l.id === location.hash);
