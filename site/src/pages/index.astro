---
// The home page: each section is a level in a corridor. A canvas draws the
// corridor with its own projection; the cards are flat HTML that the camera
// only scales and fades, so the browser never depth-sorts 3D layers.
// The long-form page lives at /paper. Figures come from src/data/bench.js.
import Base from "../layouts/Base.astro";
import Pips from "../components/Pips.astro";
import { echoRows, tokyoConnect, resources } from "../data/bench.js";

const num = (s: string) => parseFloat(s.replace(/,/g, ""));
const pct = (v: number, max: number) => `${Math.min(100, (v / max) * 100).toFixed(1)}%`;
// ssh never echoed on the 1 Mbit/s link, so its bar runs the full scale.
const echo = echoRows.map((r) => ({
  ...r,
  ow: pct(num(r.o), 2000),
  sw: Number.isNaN(num(r.s)) ? "100%" : pct(num(r.s), 2000),
}));
const tokyo = tokyoConnect.map((r) => ({
  ...r,
  w: pct(num(r.v), 2000),
  fill: r.name === "osewa QUIC" ? "var(--redD)" : "#6E6E69",
}));
const cost = resources.map((c) => {
  const vals = c.rows.map((r) => num(r.v));
  const max = Math.max(...vals);
  const min = Math.min(...vals);
  return { ...c, rows: c.rows.map((r, i) => ({ ...r, w: pct(vals[i], max), fill: vals[i] === min ? "var(--red)" : "var(--gray)" })) };
});

// What search engines read as the product; keep it to facts the page states.
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://osewa.dev/#site",
      name: "osewa",
      url: "https://osewa.dev/",
    },
    {
      "@type": "SoftwareApplication",
      name: "osewa",
      url: "https://osewa.dev/",
      description:
        "Faster than ssh, survives like mosh, never garbles. A persistent remote terminal over QUIC or TLS WebSocket, built for long-running coding agents.",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      sameAs: ["https://github.com/rjyo/osewa"],
      image: "https://osewa.dev/og.jpg?v=2",
    },
  ],
};
---
<Base schema={schema}>
<style is:global>
:root {
  --red: #E0393E; --redD: #FF6A4D; --paper: #F4F4F1; --white: #FFFFFF; --ink: #111111; --gray: #8F8F89;
  --env: #F4F4F1; --fg: #111111; --grid: rgba(17,17,17,.13);
}
* { box-sizing: border-box; }
html.js { scroll-snap-type: y mandatory; }
body { margin: 0; background: var(--env); color: var(--fg); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
.spacer > div { height: 100vh; scroll-snap-align: start; }

/* ---------- stage ----------
   The corridor is drawn on a canvas with our own projection. Cards are flat DOM,
   only scaled and faded, so the browser never has to depth-sort 3D layers. */
#stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
#cards { position: fixed; inset: 0; overflow: hidden; pointer-events: none; }
#cards .level { position: absolute; left: 50%; top: 50%; transform-origin: 50% 50%; }
#cards .level.on { pointer-events: auto; }

.level { width: min(1000px, 92vw); transform: translate(-50%, -50%); background: var(--card, var(--white)); color: var(--cfg, var(--ink));
  border: 2px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); padding: clamp(20px, 3.4vw, 44px); }
.level.dark { --card: #111; --cfg: #F4F4F1; border-color: #F4F4F1; box-shadow: 10px 10px 0 var(--red); }
.level:not(.on) { pointer-events: none; }
.eyebrow { font: 600 12px var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 14px; display: flex; gap: 14px; flex-wrap: wrap; }
.eyebrow .dim { color: var(--gray); }
h1 { margin: 0; font-size: clamp(36px, 5vw, 68px); line-height: .95; font-weight: 600; letter-spacing: -.05em; }
h2 { margin: 0 0 18px; font-size: clamp(28px, 3.8vw, 46px); line-height: 1.02; font-weight: 600; letter-spacing: -.04em; max-width: 900px; }
p { line-height: 1.5; margin: 0; }
.red { color: var(--red); }
.row { display: flex; gap: 20px; flex-wrap: wrap; }
.btn { font: 600 14px var(--mono); padding: 12px 18px; border: 2px solid var(--ink); background: var(--white); color: var(--ink); text-decoration: none; display: inline-block; }
.btn.p { background: var(--red); border-color: var(--red); color: #fff; }
.btn:hover { color: var(--ink); background: var(--paper); } .btn.p:hover { color: #fff; background: #B8262C; border-color: #B8262C; }
.hud a, .hint a, .eyebrow a { color: inherit; text-decoration: none; } .hud a:hover, .hint a:hover, .eyebrow a:hover { color: var(--red); }
.term { background: #111; color: #F4F4F1; font: 14px/1.75 var(--mono); padding: 18px 22px; border-radius: 4px; }
.term .pr { color: var(--redD); } .term .cm { color: #6E6E69; }
.blink { animation: blink 1s steps(1) infinite; } @keyframes blink { 50% { opacity: 0; } }

/* level-specific */
.press { margin-top: 28px; font: 600 13px var(--mono); letter-spacing: .2em; }
.hist div { opacity: 0; } .on .hist div { animation: in .01s forwards; }
.on .hist div:nth-child(2) { animation-delay: .5s } .on .hist div:nth-child(3) { animation-delay: 1s } .on .hist div:nth-child(4) { animation-delay: 1.5s } .on .hist div:nth-child(5) { animation-delay: 2s }
@keyframes in { to { opacity: 1; } }

.chars { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 8px; }
.char { border: 2px solid var(--ink); padding: 18px; position: relative; background: var(--paper); }
.char.sel { border-color: var(--red); box-shadow: 0 0 0 3px var(--red) inset; background: #fff; }
.char.sel::after { content: "P1"; position: absolute; top: -12px; right: 14px; background: var(--red); color: #fff; font: 700 12px var(--mono); padding: 2px 8px; }
.char h3 { margin: 0; font: 700 22px var(--mono); display: flex; justify-content: space-between; }
.char h3 span { color: var(--gray); font-weight: 500; font-size: 14px; }
.char p { font-size: 14px; margin: 10px 0 14px; color: #44443F; }
.stat { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 8px; font: 600 11px var(--mono); letter-spacing: .06em; margin-top: 6px; }
.pips { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; }
.pips i { height: 10px; background: #DDDDD6; transform: scaleY(.3); transition: transform .3s, background .3s; }
.on .pips i.f { background: var(--ink); transform: none; }
.on .sel .pips i.f { background: var(--red); }

.bars { display: grid; gap: 18px; margin-top: 6px; }
.brow { display: grid; grid-template-columns: 150px 1fr 90px; gap: 16px; align-items: center; }
.brow .name { font-weight: 600; } .brow .cond { font: 12px var(--mono); color: var(--gray); }
.track { display: grid; gap: 5px; font: 12px var(--mono); }
.bw { display: flex; align-items: center; gap: 8px; white-space: nowrap; font: 12px var(--mono); }
.bar { flex: none; height: 18px; width: 0; transition: width 1.1s cubic-bezier(.2,.8,.2,1); display: flex; align-items: center; }
.combo { font: 800 30px var(--mono); color: var(--red); text-align: right; transform: scale(0); transition: transform .4s cubic-bezier(.3,1.6,.5,1) .9s; }
.on .combo { transform: none; }
.combo small { display: block; font-size: 10px; letter-spacing: .14em; color: var(--gray); font-weight: 600; }

.mini { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
.mini h4 { margin: 0 0 2px; font-size: 15px; } .mini .note { font: 11px var(--mono); color: var(--gray); margin-bottom: 8px; }
.mrow { display: grid; grid-template-columns: 50px 1fr; gap: 8px; font: 12px var(--mono); align-items: center; margin: 4px 0; }

.map { position: relative; margin: 30px 0 10px; }
.map .line { position: absolute; left: 3%; right: 3%; top: 21px; height: 4px; background: repeating-linear-gradient(90deg, var(--ink) 0 10px, transparent 10px 18px); }
.map .done { position: absolute; left: 3%; top: 21px; height: 4px; background: var(--red); width: 0; transition: width 1.4s ease .2s; }
.on .map .done { width: 47%; }
.nodes { display: grid; grid-template-columns: repeat(7, 1fr); position: relative; }
.node { text-align: center; font: 11px var(--mono); padding: 0 4px; }
.node .dot { width: 46px; height: 46px; margin: 0 auto 10px; border: 3px solid var(--ink); background: #fff; display: grid; place-items: center; font: 700 14px var(--mono); }
.node.ok .dot { background: var(--ink); color: #fff; }
.node.here .dot { background: var(--red); border-color: var(--red); color: #fff; animation: bob 1s ease-in-out infinite; }
.node b { display: block; font: 600 13px var(--sans); margin-top: 2px; }
@keyframes bob { 50% { transform: translateY(-6px); } }
.here-tag { color: var(--red); font-weight: 700; }

.how { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.how div { border-top: 3px solid var(--ink); padding-top: 12px; }
.how .k { font: 600 11px var(--mono); color: var(--red); letter-spacing: .12em; }
.how h3 { margin: 6px 0 8px; font-size: 19px; letter-spacing: -.02em; }
.how p { font-size: 14px; color: #44443F; }

.race { margin-top: 22px; font: 12px var(--mono); display: grid; gap: 8px; }
.lane { display: grid; grid-template-columns: 170px 1fr; align-items: center; gap: 12px; }
.lane .t { height: 6px; background: #E6E6E0; position: relative; }
.lane .t i { position: absolute; left: 0; top: -5px; width: 16px; height: 16px; background: var(--red); }
.on .lane.q .t i { animation: run 1.2s cubic-bezier(.4,0,.2,1) .2s forwards; }
.on .lane.w .t i { background: var(--gray); animation: run 1.6s cubic-bezier(.4,0,.2,1) .5s forwards; }
@keyframes run { to { left: calc(100% - 16px); } }

.status { display: inline-grid; gap: 4px; border: 2px solid var(--ink); padding: 14px 18px; font: 13px var(--mono); background: var(--paper); margin: 8px 0 22px; }
.status .s { color: var(--red); font-weight: 700; }
.end { margin-top: 10px; padding-top: 20px; border-top: 2px dashed var(--ink); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
.end .big { font: 800 clamp(22px, 3vw, 34px) var(--mono); letter-spacing: .04em; }

/* ---------- HUD ---------- */
.hud { position: fixed; z-index: 10; font: 600 12px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--fg); }
.hud.tl { left: 20px; top: 16px; display: flex; align-items: center; gap: 14px; }
.hud.tl .lv { border: 2px solid var(--fg); padding: 6px 10px; }
.hud.tl .lv b { color: var(--red); }
.hud.tr { right: 20px; top: 20px; display: flex; gap: 18px; align-items: baseline; }
/* A decoration takes no layout room, so the word keeps the same baseline as the ping. */
.hud .paper { text-decoration: underline 2px var(--red); text-underline-offset: 6px; }
.sig { display: inline-flex; gap: 2px; align-items: flex-end; height: 12px; } .sig i { width: 3px; background: var(--red); }
.idx { position: fixed; z-index: 10; left: 20px; top: 50%; transform: translateY(-50%); display: grid; gap: 4px; }
.idx .hl { position: absolute; left: 0; right: 0; top: 0; background: var(--fg); pointer-events: none; z-index: 0; transition: transform .22s cubic-bezier(.3,.7,.3,1); }
.idx button { all: unset; cursor: pointer; font: 600 11px var(--mono); letter-spacing: .1em; position: relative; z-index: 1; color: color-mix(in srgb, var(--fg) 45%, transparent); display: grid; grid-template-columns: 16px 26px auto; gap: 6px; padding: 4px 6px; text-transform: uppercase; }
.idx button:hover { color: var(--fg); }
.idx button.v { color: color-mix(in srgb, var(--fg) 72%, transparent); }
.idx button.cur { color: var(--env); }
.idx button .ck { color: var(--red); display: grid; place-items: center; }
.idx button .ck svg { display: block; }
.bot { position: fixed; z-index: 10; left: 20px; right: 20px; bottom: 16px; display: grid; gap: 8px; }
/* The bottom bar repeats the side index, so it only shows where that is hidden. */
.segs { display: none; gap: 3px; position: relative; }
.segs button { all: unset; cursor: pointer; height: 14px; position: relative; }
.segs button::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: color-mix(in srgb, var(--fg) 14%, transparent); }
.segs button.v::after { background: color-mix(in srgb, var(--fg) 45%, transparent); }
.segs .fill { position: absolute; bottom: 0; height: 3px; left: 0; background: var(--red); pointer-events: none; transition: transform .22s cubic-bezier(.3,.7,.3,1); }
.hint { display: flex; justify-content: space-between; font: 600 10px var(--mono); letter-spacing: .12em; color: var(--fg); opacity: .45; text-transform: uppercase; }
.neko { overflow: visible; }
.neko-paw { transform-box: view-box; transform-origin: 82px 61px; }
.wave .neko-paw { animation: wave .9s ease-in-out; }
@keyframes wave { 20%, 60% { transform: rotate(-24deg); } 40%, 80% { transform: rotate(8deg); } }
.banner { position: fixed; z-index: 11; left: 50%; top: 70px; transform: translate(-50%, -20px); opacity: 0; transition: .35s; pointer-events: none;
  background: var(--ink); color: #fff; font: 700 14px var(--mono); letter-spacing: .16em; padding: 10px 18px; white-space: nowrap; display: flex; align-items: center; gap: 10px; }
.banner svg { display: block; flex: none; }
.banner.show { opacity: 1; transform: translate(-50%, 0); }
.banner .c { color: var(--redD); }
@media (max-width: 1280px) { .idx { display: none; } .segs { display: grid; } }
@media (max-width: 860px) {
  .idx, .hud.tr .keys { display: none; }
  .brow { grid-template-columns: 1fr; gap: 6px; } .combo { text-align: left; }
  .nodes { grid-template-columns: repeat(4, 1fr); row-gap: 16px; } .map .line, .map .done { display: none; }
  .lane { grid-template-columns: 1fr; }
}
/* Phones: the card already names the level, so the header names only the number and there is no banner. */
@media (max-width: 600px) {
  .hud .word, .hud .nm, .hud .proto { display: none; }
  .hud.tl { gap: 10px; left: calc(16px + env(safe-area-inset-left, 0px)); }
  .hud.tr { right: calc(16px + env(safe-area-inset-right, 0px)); }
  .bot { left: 16px; right: 16px; bottom: 10px; gap: 6px; }
  .hud { font-size: 10px; }
  .hud.tl { top: 10px; gap: 8px; } .hud.tr { top: 14px; gap: 12px; }
  .hud.tl .neko { width: 22px; height: 22px; }
  .banner { display: none; }
  /* The main action gets its own line; the two others share the next. */
  .cta .btn { flex: 1; text-align: center; white-space: nowrap; padding: 12px; font-size: 13px; }
  .cta .btn.p { flex-basis: 100%; }
  .hud.tl .lv { padding: 3px 7px; border-width: 1.5px; }
  .level { padding: 18px; box-shadow: 6px 6px 0 var(--ink); }
  .level.dark { box-shadow: 6px 6px 0 var(--red); }
}
/* Without JS there is no camera: the levels are a plain page. */
html:not(.js) #stage, html:not(.js) .hud, html:not(.js) .idx, html:not(.js) .bot, html:not(.js) .spacer, html:not(.js) .banner, html:not(.js) .press { display: none; }
html:not(.js) #cards { position: static; display: grid; gap: 48px; padding: 48px 16px; overflow: visible; pointer-events: auto; }
html:not(.js) #cards .level { position: static; transform: none; margin: 0 auto; pointer-events: auto; }
html:not(.js) .hist div { opacity: 1; }
html:not(.js) .pips i.f { background: var(--ink); transform: none; }
html:not(.js) .bar { width: calc(var(--w) * .78); }
html:not(.js) .combo { transform: none; }
</style>

<canvas id="stage" aria-hidden="true"></canvas>
<div id="cards">

  <!-- 00 BOOT -->
  <section class="level" id="boot" data-name="boot">
    <div class="eyebrow"><span>Wire protocol v0 · open source</span><a class="dim" href="/paper#security">TLS 1.3 · Ed25519 keys on both ends · port 7322</a></div>
    <div class="row" style="align-items: flex-end; justify-content: space-between; gap: 32px">
      <div style="flex: 1 1 520px">
        <h1>Faster than ssh,<br> survives like mosh,<br> never garbles<span class="red">.</span></h1>
        <p style="font-size: 20px; margin: 22px 0 24px; max-width: 560px">The terminal protocol for the age of agents. Your agent runs for hours on the host; check in from a laptop or a phone, on any network.</p>
        <div class="row cta" style="gap: 10px"><a class="btn p" href="#quick-start" data-go="5">Get started →</a><a class="btn" href="/paper">Read the paper</a><a class="btn" href="https://github.com/rjyo/osewa">Star on GitHub</a></div>
      </div>
      <div class="term hist" style="flex: 0 1 330px">
        <div><span class="pr">$</span> history</div>
        <div>  1995  ssh devbox</div>
        <div>  2012  mosh devbox</div>
        <div>  2026  osewa attach devbox</div>
        <div><span class="pr">$</span> <span class="blink">▍</span></div>
      </div>
    </div>
    <div class="press"><span class="blink">▼</span> PRESS ↓ OR SCROLL TO START</div>
  </section>

  <!-- 01 WHY -->
  <section class="level" id="why" data-name="why now">
    <div class="eyebrow"><span>§1 Why now</span><span class="dim">select your protocol</span></div>
    <h2>ssh and mosh were built for networks we no longer have.</h2>
    <div class="chars">
      <div class="char"><h3>ssh <span>1995</span></h3><p>The session is its TCP connection: it dies when the network changes, and each key waits behind the download.</p>
        <div class="stat">ROAMING<Pips v={1} /></div><div class="stat">ECHO / LOAD<Pips v={1} /></div><div class="stat">FIDELITY<Pips v={5} /></div></div>
      <div class="char"><h3>mosh <span>2012</span></h3><p>Survives roaming, but its own emulator can garble your screen. UDP only, no forwards, no scrollback.</p>
        <div class="stat">ROAMING<Pips v={4} /></div><div class="stat">ECHO / LOAD<Pips v={3} /></div><div class="stat">FIDELITY<Pips v={2} /></div></div>
      <div class="char sel"><h3>osewa <span>2026</span></h3><p>The session lives on the host with Ghostty's engine. Forwards and exec share the connection, over QUIC or TCP.</p>
        <div class="stat">ROAMING<Pips v={5} /></div><div class="stat">ECHO / LOAD<Pips v={5} /></div><div class="stat">FIDELITY<Pips v={5} /></div></div>
    </div>
  </section>

  <!-- 02 BENCH -->
  <section class="level" id="bench" data-name="benchmarks">
    <div class="eyebrow"><span>§2 Benchmarks</span><span class="dim">key echo while a download runs</span></div>
    <h2>On a bad network, keys echo 8–100× faster than ssh.</h2>
    <div class="bars" id="echo">
      {echo.map((r) => (
        <div class="brow">
          <div><div class="name">{r.name}</div><div class="cond">{r.cond}</div></div>
          <div class="track">
            <div class="bw"><div class="bar" data-w={r.ow} style={`--w: ${r.ow}; background: var(--red)`}></div><span>osewa {r.o}</span></div>
            <div class="bw"><div class="bar" data-w={r.sw} style={`--w: ${r.sw}; background: var(--gray)`}></div><span>ssh {r.s}</span></div>
          </div>
          <div class="combo">{r.x}<small>COMBO</small></div>
        </div>
      ))}
    </div>
  </section>

  <!-- 03 TOKYO -->
  <section class="level dark" id="tokyo" data-name="tokyo" data-env="#111111">
    <div class="eyebrow"><span>§3 World 2 · public internet</span><span class="dim">Thailand → Tokyo</span></div>
    <h2>Thailand to Tokyo, over the public internet.</h2>
    <p style="font: 12px var(--mono); color: #8F8F89; margin-bottom: 14px">CONNECT + RUN A COMMAND · LOWER WINS</p>
    <div class="bars" id="tokyo" style="gap: 12px">
      {tokyo.map((r) => (
        <div class="brow" style="grid-template-columns: 120px 1fr">
          <div class="name" style="font: 600 13px var(--mono)">{r.name}</div>
          <div class="bw"><div class="bar" data-w={r.w} style={`--w: ${r.w}; background: ${r.fill}; height: 26px`}></div><span>{r.v}</span></div>
        </div>
      ))}
    </div>
  </section>

  <!-- 04 COST -->
  <section class="level" id="cost" data-name="cost" data-env="#F4F4F1">
    <div class="eyebrow"><span>§4 Resources</span><span class="dim">the red bar is the winner, even when it's ssh</span></div>
    <h2>Light when idle. Honest about the cost.</h2>
    <div class="mini" id="cost">
      {cost.map((c) => (
        <div>
          <h4>{c.title}</h4><div class="note">{c.note}</div>
          {c.rows.map((r) => (
            <div class="mrow"><span>{r.n}</span><div class="bw" style="min-width: 0"><div class="bar" data-w={r.w} style={`--w: ${r.w}; background: ${r.fill}; height: 16px`}></div><span>{r.v}</span></div></div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- 05 START -->
  <section class="level" id="quick-start" data-name="quick start">
    <div class="eyebrow"><span>§5 Quick start</span><span class="dim">Linux and macOS hosts</span></div>
    <h2>ssh once. osewa after that.</h2>
    <div class="term hist">
      <div><span class="pr">$</span> osewa login --service me@devbox   <span class="cm"># install, enroll, run as a service</span></div>
      <div><span class="pr">$</span> osewa attach devbox               <span class="cm"># attach to (or create) a session</span></div>
      <div><span class="pr">$</span> osewa forward devbox 3000         <span class="cm"># forward localhost:3000</span></div>
      <div><span class="pr">$</span> osewa exec devbox -- make test    <span class="cm"># run a command, no terminal</span></div>
      <div><span class="pr">$</span> osewa update devbox               <span class="cm"># upgrade the host over osewa</span></div>
    </div>
  </section>

  <!-- 06 ROADMAP -->
  <section class="level" id="roadmap" data-name="roadmap">
    <div class="eyebrow"><span>§6 Roadmap</span><span class="dim">world map</span></div>
    <h2>A transport any terminal can ride, then a mux on top.</h2>
    <div class="map"><div class="line"></div><div class="done"></div>
      <div class="nodes">
