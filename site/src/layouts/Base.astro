---
import "../styles/global.css";
// The same hashed files global.css's @font-face points at, preloaded so
// text paints in the real fonts on first load.
import sans from "../fonts/inter-tight.woff2?url";
import mono from "../fonts/jetbrains-mono.woff2?url";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  // Pages that must stay out of search results (the 404).
  noindex?: boolean;
  // JSON-LD for this page, if any.
  schema?: object;
}
const {
  title = "osewa — faster than ssh, survives like mosh, never garbles",
  description = "The terminal protocol for the age of agents. Your agent runs for hours on the host; check in from a laptop or a phone, on any network, over QUIC or TLS WebSocket.",
  path = "/",
  noindex = false,
  schema,
} = Astro.props;
const url = new URL(path, "https://osewa.dev").href;
// Card images must be absolute URLs. Source: og/og.html.
// Bump ?v= whenever og.jpg changes: link previews cache by URL.
const image = "https://osewa.dev/og.jpg?v=2";
const imageAlt =
  "osewa: faster than ssh, survives like mosh, never garbles. A white maneki-neko with a red collar and gold bell beside the headline, and ssh 1995, mosh 2012, osewa 2026.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4F4F1" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="osewa" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
  </head>
  <body style="font-family: var(--sans); color: #111111">
    <slot />
    <script>
      // Toggles: a button sets one key ("udp", "mode"); elements tagged
      // data-when="key:value" show only for the current value.
      for (const b of document.querySelectorAll<HTMLButtonElement>("[data-set]")) {
        b.addEventListener("click", () => {
          const [key, val] = b.dataset.set!.split(":");
          for (const o of document.querySelectorAll<HTMLButtonElement>(`[data-set^="${key}:"]`)) {
            o.setAttribute("aria-pressed", String(o === b));
          }
          for (const el of document.querySelectorAll<HTMLElement>(`[data-when^="${key}:"]`)) {
            el.hidden = el.dataset.when !== `${key}:${val}`;
          }
        });
      }
      // Logo: the paw is a pendulum, angle = A·sin(phase). The phase always
      // advances, so the motion never jumps; only the swing A changes.
      // Hovering feeds A up to its full swing, leaving lets it decay, and the
      // page load gives it one push. The word flies out the first time the
      // paw reaches its right-hand peak.
      const neko = document.querySelector<HTMLElement>(".neko-link");
      const paw = neko?.querySelector<SVGElement>(".neko-paw");
      const word = neko?.querySelector<HTMLElement>(".neko-word");
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!neko || !paw || !word || still) {
        word?.classList.add("out");
      } else {
        const FULL = 12; // degrees
        const PERIOD = 1.4; // seconds per back-and-forth
        const GROW = 0.25; // time constant while fed
        const FADE = 0.6; // time constant while dying down
        let amp = 0, phase = 0, feed = true, hovering = false, last = 0, raf = 0;
        let pushUntil = performance.now() + 1300; // the load push
        const frame = (now: number) => {
          const dt = Math.min(0.05, (now - last) / 1000);
          last = now;
          feed = hovering || now < pushUntil;
          amp = feed ? amp + (FULL - amp) * (1 - Math.exp(-dt / GROW)) : amp * Math.exp(-dt / FADE);
          const before = phase;
          phase += (2 * Math.PI * dt) / PERIOD;
          // First pass through the right-hand peak (phase = π/2).
          if (before < Math.PI / 2 && phase >= Math.PI / 2) word.classList.add("out");
          paw.style.transform = `rotate(${amp * Math.sin(phase)}deg)`;
          if (!feed && amp < 0.05) {
            amp = 0;
            paw.style.transform = "";
            raf = 0;
            return;
          }
          raf = requestAnimationFrame(frame);
        };
        const start = () => {
          if (raf) return;
          last = performance.now();
          raf = requestAnimationFrame(frame);
        };
        neko.addEventListener("mouseenter", () => {
          hovering = true;
          start();
        });
        neko.addEventListener("mouseleave", () => (hovering = false));
        start();
      }
      // Copy buttons.
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!);
            btn.textContent = "copied";
          } catch {
            btn.textContent = "select it";
          }
          setTimeout(() => (btn.textContent = "copy"), 1600);
        });
      }
      // Replay: re-inserting the bars restarts their CSS animations.
      const bars = document.getElementById("replay-bars");
      document.querySelector("[data-replay]")?.addEventListener("click", () => {
        if (!bars) return;
        const fresh = bars.cloneNode(true);
        bars.replaceWith(fresh);
        (fresh as HTMLElement).id = "replay-bars";
      });
    </script>
  </body>
</html>
